# --------------------------------------------------
# ChronosQ production environment example
# --------------------------------------------------

# Docker Compose project name
COMPOSE_PROJECT_NAME=chronosq

# PostgreSQL configuration
POSTGRES_DB=chronosq
POSTGRES_USER=chronosq

# Replace this example before starting the application.
# Use a long and randomly generated password in production.
POSTGRES_PASSWORD=getahellbutnotheaven@780021

# ChronosQ HTTP port exposed on the host machine
CHRONOSQ_HTTP_PORT=8080

# Maximum number of database connections
CHRONOSQ_DB_POOL_SIZE=20